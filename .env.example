# Conexion a PostgreSQL (Neon). El valor real NUNCA se commitea ni se comparte
# por chat grupal: se pasa 1 a 1 o por gestor de contrasenas.
DATABASE_URL=postgresql://usuario:password@host/nombre_db?sslmode=require

# Clave de firma de sesiones de Better Auth.
# Generar una con: openssl rand -base64 32
BETTER_AUTH_SECRET=una-clave-secreta-larga-y-aleatoria

# URL publica del backend. En local se puede omitir (default http://localhost:4000).
# En Render va la URL del servicio desplegado.
BETTER_AUTH_URL=http://localhost:4000

# Origenes autorizados a mandar cookies de sesion, separados por coma.
# En local es el dev server de Vite; en produccion, la URL de Vercel.
TRUSTED_ORIGINS=http://localhost:5173

# Envio de correos (HU-3, recuperacion de contrasena). Se saca del panel de
# Resend. Si se deja vacia, el backend NO falla: escribe el correo entero en la
# consola con el link adentro, para poder probar el flujo igual.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Remitente de los correos. Mientras no haya dominio propio verificado en
# Resend hay que dejar el de prueba: sin dominio, Resend solo acepta mandarle a
# la casilla con la que se registro la cuenta.
CORREO_REMITENTE=Stock <onboarding@resend.dev>

# A donde apunta el link de recuperacion que va en el correo: la URL publica
# del FRONTEND, no la del backend. Si se omite, se usa el primero de
# TRUSTED_ORIGINS.
FRONTEND_URL=http://localhost:5173

# Proveedor de LLM para el Asistente Inteligente (E5). Ver ADR-2 / T-08.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

PORT=4000
